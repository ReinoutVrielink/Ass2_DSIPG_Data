   "source": [
    "import pandas as pd\n",
    "\n",
    "df = pd.read_csv(\"ongevallen.txt\", low_memory=False)\n",
    "\n",
    "# Amsterdam heeft GME_ID 363, en we halen de coronajaren weg\n",
    "ams = df[(df[\"GME_ID\"] == 363) & (~df[\"JAAR_VKL\"].isin([2020, 2021]))].copy()\n",
    "ams.to_csv(\"amsterdam_ongevallen.csv\", index=False)"
   ]
  }
